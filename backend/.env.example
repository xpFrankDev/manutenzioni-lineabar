# Copia este archivo como .env. No lo subas al repositorio.
NODE_ENV=development
PORT=3001

# Conexión a MariaDB. En local apunta al puerto publicado por docker compose.
DB_HOST=127.0.0.1
DB_PORT=3306
MARIADB_DATABASE=lineabar
LINEABAR_DB_USER=lineabar_app
LINEABAR_DB_PASSWORD=valor_local_solo_desarrollo

# Solo para ejecutar `npm run migraciones` fuera de Docker, con el usuario DDL.
LINEABAR_MIGRATIONS_USER=lineabar_migraciones
LINEABAR_MIGRATIONS_PASSWORD=valor_migraciones_local

JWT_SECRET=reemplaza_por_un_secreto_largo_aleatorio
CORS_ORIGIN=http://localhost:5173
# Proxies de confianza delante de la API: 0 en local sin proxy, 2 detrás de
# Nginx del host + Nginx del contenedor frontend.
TRUST_PROXY_HOPS=0
# Ruta de las cookies de sesión. En producción el SPA vive bajo /lineabar/api.
# COOKIE_PATH=/lineabar/api

# Duración del token de acceso y de la sesión de refresco.
LINEABAR_ACCESO_MINUTOS=10
LINEABAR_REFRESCO_DIAS=30

# Análisis del scontrino: por defecto Tesseract local (gratis, sin API).
LINEABAR_OCR_PROVEEDOR=tesseract
LINEABAR_OCR_IDIOMAS=ita
LINEABAR_OCR_ENDPOINT=
LINEABAR_OCR_API_KEY=
LINEABAR_OCR_MODELO=gpt-4o-mini
LINEABAR_OCR_TIEMPO_LIMITE_MS=60000
LINEABAR_OCR_MAX_BYTES=8388608

# Usuario administrador inicial. La contraseña se cifra en tiempo de ejecución y
# se sincroniza en cada arranque; nunca se guarda en el repositorio.
LINEABAR_ADMIN_USER=dev01
LINEABAR_ADMIN_EMAIL=dev@lineabar.it
LINEABAR_ADMIN_NOMBRE=Sviluppatore Linea Bar
LINEABAR_ADMIN_PASSWORD=reemplaza_esta_contrasena

# Carga clientes, máquinas y registros ficticios. Déjalo en 0 en producción.
LINEABAR_CARGAR_DEMO=1
