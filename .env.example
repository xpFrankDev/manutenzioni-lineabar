# Copia este archivo como .env y reemplaza cada valor. Nunca subas .env al repositorio.

# MariaDB
MARIADB_DATABASE=lineabar
MARIADB_ROOT_PASSWORD=reemplaza_por_una_contrasena_larga_aleatoria
# Usuario de la aplicación: solo SELECT, INSERT, UPDATE y DELETE.
LINEABAR_DB_USER=lineabar_app
LINEABAR_DB_PASSWORD=reemplaza_por_una_contrasena_larga_aleatoria
# Usuario de migraciones: añade DDL limitado a la base lineabar.
LINEABAR_MIGRATIONS_USER=lineabar_migraciones
LINEABAR_MIGRATIONS_PASSWORD=reemplaza_por_una_contrasena_larga_aleatoria
# Puerto de MariaDB publicado solo en 127.0.0.1 para conectarse con DBeaver.
LINEABAR_DB_PORT=3308

# Aplicación
JWT_SECRET=reemplaza_por_un_secreto_largo_aleatorio
# Proxies de confianza delante de la API (Nginx del host + Nginx del contenedor).
TRUST_PROXY_HOPS=2
# En producción las cookies se emiten para /lineabar/api; no cambiar sin
# actualizar el proxy del SPA.
# COOKIE_PATH=/lineabar/api
# Token de acceso corto + sesión de refresco rotativa.
LINEABAR_ACCESO_MINUTOS=10
LINEABAR_REFRESCO_DIAS=30
# En producción usa el origen público real, por ejemplo https://tu-dominio.
CORS_ORIGIN=http://localhost:8091
# Puerto de loopback donde Nginx publica el contenedor frontend.
LINEABAR_PORT=8091

# Usuario administrador inicial. La contraseña declarada aquí se sincroniza en
# cada arranque: cambiarla en .env y reejecutar la inicialización la rota.
LINEABAR_ADMIN_USER=dev01
LINEABAR_ADMIN_EMAIL=dev@lineabar.it
LINEABAR_ADMIN_NOMBRE=Sviluppatore Linea Bar
LINEABAR_ADMIN_PASSWORD=reemplaza_esta_contrasena

# 1 carga clientes, máquinas y registros ficticios; déjalo en 0 en producción.
LINEABAR_CARGAR_DEMO=1
# 1 carga clientes/máquinas de Abruzzo para probar la programación por rutas.
LINEABAR_CARGAR_ABRUZZO=0

# Análisis del scontrino. Por defecto usa Tesseract local (gratis, sin API).
# Proveedores: tesseract | openai | ninguno
LINEABAR_OCR_PROVEEDOR=tesseract
LINEABAR_OCR_IDIOMAS=ita
# Solo si algún día se quiere un servicio multimodal compatible con OpenAI.
LINEABAR_OCR_ENDPOINT=
LINEABAR_OCR_API_KEY=
LINEABAR_OCR_MODELO=gpt-4o-mini
LINEABAR_OCR_TIEMPO_LIMITE_MS=60000

# Programación asistida por IA. El endpoint debe ser compatible con
# Chat Completions (OpenCode Go u otro gateway). La clave se guarda solo en el
# .env del servidor y nunca se versiona; si falta, se usa el planificador local.
# Acceso con Google. Crear credenciales OAuth 2.0 (tipo Web) en Google Cloud.
# Autorizar el redirect URI exacto: <origen>/lineabar/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

LINEABAR_AI_ENDPOINT=https://opencode.ai/inference/openai/v1/chat/completions
LINEABAR_AI_API_KEY=
LINEABAR_AI_MODELO=deepseek-v4.1-flash
# low | high | max (DeepSeek V4.1 Flash). También se acepta modelo#high.
LINEABAR_AI_REASONING_EFFORT=high
LINEABAR_AI_TIEMPO_LIMITE_MS=45000
